# Dashboard Environment Variables Example
# Copy this file to .env and fill in your values.

# Backend REST API and WebSocket URLs
REACT_APP_API_URL=http://localhost:3001
REACT_APP_SOCKET_URL=http://localhost:3001
REACT_APP_FRONTEND_URL=http://localhost:5173

# Razorpay Public Test Key ID (Safe for frontend exposure, never put secret keys here)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

