# ==============================================================================
# Zerodha Paper-Trading Platform - Environment Variables Reference (.env.example)
# ==============================================================================
# NOTE: Never commit actual secret credentials or real API keys to version control.
# Copy this file to backend/.env, dashboard/.env, or frontend/.env and substitute values.

# ------------------------------------------------------------------------------
# Backend & API Configuration
# ------------------------------------------------------------------------------
PORT=3002
MONGO_URL=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER-URL>/<DATABASE-NAME>?retryWrites=true&w=majority
TOKEN_KEY=your_secure_jwt_secret_key_here

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Strictly Test Mode for Paper-Trading Simulation)
# ------------------------------------------------------------------------------
# Primary backend keys (Generated from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_test_key_secret

# Optional aliases supported by config/razorpay.js:
RAZORPAY_TEST_API_KEY=rzp_test_placeholder_key_id
RAZORPAY_TEST_KEY_SECRET=placeholder_test_key_secret

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ------------------------------------------------------------------------------
# Frontend & Dashboard Public Configuration
# ------------------------------------------------------------------------------
# Dashboard (Create React App / Vite)
REACT_APP_API_URL=http://localhost:3002
REACT_APP_SOCKET_URL=http://localhost:3002
REACT_APP_FRONTEND_URL=http://localhost:5173
REACT_APP_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# ------------------------------------------------------------------------------
# Optional External Services
# ------------------------------------------------------------------------------
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GRAPHIFY_ENABLED=true
GRAPHIFY_PATH=./graphify-out

