# Server Environment & Port Configuration
PORT=3001
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local replica set)
MONGO_URL=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER-URL>/<DATABASE-NAME>?retryWrites=true&w=majority

# JWT Token Secret for Auth Signatures (generate with: openssl rand -base64 32)
TOKEN_KEY=your_secure_jwt_secret_key_here

# Allowed CORS Origins (comma-separated for multiple environments)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:3000

# External Market Data API Key (Twelve Data - Free Tier: 8 credits/min)
# Optional: If omitted or rate-limited, the backend automatically uses cached/fallback data.
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Google Gemini API Key for AI Portfolio Diagnostics
# Optional: If omitted or invalid, the backend uses a built-in deterministic rule engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway (Strictly Test Mode for educational paper-trading)
# Get keys from Razorpay Dashboard -> Settings -> API Keys (Generate Test Key)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_test_key_secret
# Backward-compatible environment variable aliases:
RAZORPAY_TEST_API_KEY=rzp_test_placeholder_key_id
RAZORPAY_TEST_KEY_SECRET=placeholder_test_key_secret
# Razorpay Webhook Secret (configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Graphify Knowledge Graph & Chart Engine
GRAPHIFY_ENABLED=true
GRAPHIFY_PATH=../graphify-out
